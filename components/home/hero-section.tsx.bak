                <div className="absolute inset-0 bg-gradient-to-br from-slate-800/50 to-slate-900/50" />
                
                {/* Course Preview Card */}
                <div className="absolute inset-4 md:inset-8 bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl overflow-hidden border border-white/10">
                  <div className="aspect-video bg-gradient-to-br from-orange-900/50 to-red-900/50 relative">
                    <div className="absolute inset-0 flex items-center justify-center">
